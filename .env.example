# Copy this file to .env and fill in real values. Never commit the real .env.

# Confluence Data Center base URL, e.g. https://confluence.internal.example.com
CONFLUENCE_URL=

# Service account used to call ConfiForms/Confluence REST endpoints
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Which retrieval mechanism to use: rest | json | csv
DATA_SOURCE_TYPE=rest

# Path or full URL to the ConfiForms endpoint for the chosen DATA_SOURCE_TYPE.
# REST example: /rest/confiforms-data/1.0/entry/MyFormName
# JSON export example: /display/SPACEKEY/MyPage?confiforms-export=json&form=MyFormName
# CSV export example:  /display/SPACEKEY/MyPage?confiforms-export=csv&form=MyFormName
CONFIFORM_ENDPOINT=

# How often (seconds) cached data is refreshed server-side and the browser polls
REFRESH_INTERVAL=60

# Optional: override default status badge colors as a JSON object
# STATUS_COLORS={"Open":"#28a745","Pending":"#ffc107","Blocked":"#dc3545","Closed":"#6c757d"}

# Web server port
PORT=5000

# Set to true only for local development
FLASK_DEBUG=false

# HTTP client behaviour
REQUEST_TIMEOUT=15
VERIFY_SSL=true
